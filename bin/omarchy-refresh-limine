#!/usr/bin/env bash
set -euo pipefail

# If no limine.conf exists, install Omarchy default
if [ ! -f /boot/limine.conf ]; then
  sudo cp "${OMARCHY_PATH:-$HOME/.local/share/omarchy}/default/limine/limine.conf" /boot/limine.conf
fi

# Ensure compat path exists
sudo mkdir -p /boot/limine
sudo ln -sf /boot/limine.conf /boot/limine/limine.conf

# Regenerate Limine entries / fallback (if available)
if command -v limine-update >/dev/null 2>&1; then
  sudo limine-update
fi

# Sync snapshots
sudo limine-snapper-sync

